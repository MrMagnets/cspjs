# ---- 后端环境变量（复制为 .env 后按需修改） ----
# PostgreSQL 连接串（默认值，推荐生产使用）
# 托管平台（Render/Railway/Neon 等）注入的 postgresql:// 或 postgres:// 会被自动规范成
# postgresql+psycopg://（见 app/database.py），无需手动改驱动名。
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cspjs

# 本地没有 PostgreSQL 时允许自动降级为 SQLite（文件 cspjs.db）。
# ⚠️ 云托管必须设为 false：免费实例的本地磁盘是临时的，重启/休眠即丢数据。
ALLOW_SQLITE_FALLBACK=true
SQLITE_PATH=./cspjs.db

# JWT 密钥：生产环境务必替换为随机长字符串（可用 python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=change-me-in-production-please
JWT_EXPIRE_MINUTES=10080

# 允许跨域的前端地址，逗号分隔，必须写完整 origin（含 https://，不要末尾斜杠）。
#   · 本地开发：http://localhost:5173,http://127.0.0.1:5173
#   · 前后端分离部署（Vercel 前端 + Render 后端）：必须把前端实际域名加进来，例如
#       CORS_ORIGINS=https://cspjs.vercel.app,https://cspjs-git-main-yourname.vercel.app
#     前端换域名 / 新增预览域名后，都要同步更新并重启后端，否则浏览器会报 CORS。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 初始化管理员账号（首次启动或首次 AUTO_SEED 时写入）
# 云托管请在平台环境变量里直接填写强密码，不要沿用默认值
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminmagnet

# 启动时自动建表 + 写入演示数据（幂等）。
# 首次部署设 true 完成建表/播种，确认数据正常后改为 false 加快启动。
AUTO_SEED=true

# 是否创建演示学生账号 student/student123 与示例题单。
# 云托管务必设为 false，避免「已知密码」的账号随代码上线。
SEED_DEMO_STUDENT=true

# 模拟考试时长（分钟）
MOCK_EXAM_MINUTES=120
