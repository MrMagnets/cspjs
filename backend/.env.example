# ---- 后端环境变量（复制为 .env 后按需修改） ----
# 本文件只放占位符，任何真实密码 / 密钥都不要提交到仓库。
# Cloudflare Workers 部署时这些值不在 .env 里，而是通过 wrangler.jsonc 的 vars
# 与 `wrangler secret put` 注入（见 wrangler.jsonc）。

# 运行环境：development / production。production 下会拒绝占位符 JWT_SECRET。
ENVIRONMENT=development

# 本地 PostgreSQL 连接串。驱动为纯 Python 的 pg8000（与 Workers 保持一致）。
# 托管平台注入的 postgresql:// / postgres:// 会被自动规范成 postgresql+pg8000://。
# 本地不设置时自动使用 SQLite（见 ALLOW_SQLITE_FALLBACK）。
# 示例：DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL=

# 本地没有 PostgreSQL 时允许自动降级为 SQLite（文件 cspjs.db）。
# ⚠️ Workers/Serverless 必须设为 false：本地磁盘是临时的，重启即丢数据。
ALLOW_SQLITE_FALLBACK=true
SQLITE_PATH=./cspjs.db

# JWT 密钥（Workers 上通过 `wrangler secret put JWT_SECRET` 注入）。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-secret-here
JWT_EXPIRE_MINUTES=10080

# 允许跨域的前端地址，逗号分隔，必须写完整 origin（含 https://，不要末尾斜杠）。
# Workers 上同样通过 wrangler.jsonc 的 vars.CORS_ORIGINS 配置。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 初始化管理员（本地首次 AUTO_SEED 时写入；Workers 上请先在 Neon 建好管理员）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# 本地启动时自动建表 + 写入演示数据。Workers 上该值不生效（lifespan 被跳过）。
AUTO_SEED=true

# 演示学生账号（默认关闭）。开启时必须显式提供密码，代码中不保存固定密码。
SEED_DEMO_STUDENT=false
DEMO_STUDENT_PASSWORD=

# 模拟考试时长（分钟）
MOCK_EXAM_MINUTES=120
