# ---- 后端环境变量（复制为 .env 后按需修改） ----
# 本文件只放占位符，任何真实密码 / 密钥都不要提交到仓库。

# 运行环境：development / production。production 或 VERCEL 环境下会拒绝占位符 JWT_SECRET。
ENVIRONMENT=development

# PostgreSQL 连接串（生产必填）。驱动为 psycopg2-binary（兼容 Vercel Serverless）。
# 托管平台注入的 postgresql:// 或 postgres:// 会被自动规范成 postgresql+psycopg2://。
# 本地不设置时自动使用 SQLite（见 ALLOW_SQLITE_FALLBACK）。
# 示例：DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL=

# 本地没有 PostgreSQL 时允许自动降级为 SQLite（文件 cspjs.db）。
# ⚠️ 云托管必须设为 false：免费实例的本地磁盘是临时的，重启/休眠即丢数据。
ALLOW_SQLITE_FALLBACK=true
SQLITE_PATH=./cspjs.db

# JWT 密钥：占位符会被生产环境拒绝。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-secret-here
JWT_EXPIRE_MINUTES=10080

# 允许跨域的前端地址，逗号分隔，必须写完整 origin（含 https://，不要末尾斜杠）。
#   · 本地开发：http://localhost:5173,http://127.0.0.1:5173
#   · 前后端分离部署：必须把前端实际域名加进来，例如
#       CORS_ORIGINS=https://cspjs.vercel.app,https://cspjs-git-main-yourname.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 初始化管理员（首次启动或首次 AUTO_SEED 时写入）。
# ⚠️ 占位符仅用于本地首次体验，部署后请立即设置强密码或执行 python -m app.passwd。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# 启动时自动建表 + 写入演示数据（幂等）。
# 首次部署设 true 完成建表/播种，确认数据正常后改为 false 加快启动。
AUTO_SEED=true

# 演示学生账号（默认关闭）。开启时必须显式提供密码，代码中不保存任何固定密码。
SEED_DEMO_STUDENT=false
DEMO_STUDENT_PASSWORD=

# 模拟考试时长（分钟）
MOCK_EXAM_MINUTES=120
